# project-q environment variables
# Copy this to .env and fill in your keys

# Anthropic API key — enables fast API-based chat for conversational workflow steps
# (understand, clarify, plan, spec). Implementation steps always use Claude CLI.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenAI or Gemini API as alternative chat providers
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional: override the port (default 3141)
# PORT=3141
